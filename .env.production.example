# ============================================================================
# CANLI ORTAM ORNEGI — bu dosya depoya GIRER, gizli degerleri BOS kalir.
#
# Gercek .env sunucuda /home/scha5572/schafer_app/.env olarak durur (web'e
# kapali klasor). Depo public oldugu icin buraya yazilan her deger herkese
# acik sayilir; git gecmisi de okunabilir, yani bir kez commit'lenen parola
# YANMIS sayilir.
# ============================================================================

APP_NAME="Schafer Kıbrıs"
APP_ENV=production
# php artisan key:generate --show ile uretilir, buraya YAZILMAZ
APP_KEY=
APP_DEBUG=false
APP_URL=https://schaferkibris.com
APP_TIMEZONE=Asia/Famagusta
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# VERITABANI
#
# TUZAK: DB_HOST olarak 127.0.0.1 YAZMAYIN. cPanel yetkiyi @localhost
# verir; TCP baglantisi baska bir kimlik sayilir ve baglanti reddedilir.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# E-POSTA
#
# TUZAK: sendmail KULLANILAMAZ — Turhost'ta proc_open kapali, Symfony'nin
# sendmail tasiyicisi sessizce duser. Sunucunun kendi posta sunucusuna
# yerel SMTP (localhost:25, parolasiz) deneniyor. Reddedilirse cPanel
# e-posta hesabinin bilgileri yazilir (MAIL_HOST=mail.schaferkibris.com,
# MAIL_PORT=465, MAIL_SCHEME=smtps, MAIL_USERNAME/MAIL_PASSWORD).
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@schaferkibris.com
MAIL_FROM_NAME="${APP_NAME}"

# Gorseller storage/app/public'te; public_html/storage sembolik bagla acilir.
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# MAGAZA (cogu ayar panelden de degistirilebilir — Site Ayarlari)
# ---------------------------------------------------------------------------
SHOP_AD="Schafer Kıbrıs"
SHOP_ALAN_ADI=schaferkibris.com
SHOP_INSTAGRAM=schaferkibris
SHOP_FACEBOOK=schaferKibris
SHOP_KARGO_UCRET=250.00
SHOP_KARGO_UCRETSIZ_ESIGI=2500.00
SHOP_KARGO_FIRMA=
SHOP_SIPARIS_BILDIRIM=
SHOP_DUSUK_STOK_ESIGI=3
SHOP_BAKIM_MODU=false
SHOP_WHATSAPP=+905488477000

# Kart (PayTR) anahtarlar girilene kadar KAPALI; havale IBAN girilene kadar
# kasada zaten gizli.
SHOP_ODEME_KART=false
SHOP_ODEME_HAVALE=true
SHOP_ODEME_KAPIDA=true
SHOP_HAVALE_HESAPLARI=
SHOP_HAVALE_SURE_GUN=3
SHOP_KAPIDA_EK_UCRET=0

# Yasal metinlerde ve faturada gorunur — BOS BIRAKILIRSA metinlerde
# [GIRILMEDI] yer tutuculari cikar.
SHOP_SATICI_UNVAN=
SHOP_SATICI_ADRES="Düzyol Sokak No:10/B Gönyeli, Lefkoşa — KKTC (Garanti Bankası yanı)"
SHOP_SATICI_TELEFON="+90 392 223 55 56"
SHOP_SATICI_TELEFON2="+90 548 847 70 00"
SHOP_SATICI_EPOSTA=info@schaferkibris.com
SHOP_SATICI_MERSIS=
SHOP_SATICI_VERGI_DAIRESI=
SHOP_SATICI_VERGI_NO=

# ---------------------------------------------------------------------------
# PAYTR — uc deger PayTR magaza panelinden alinir. Callback adresi PayTR
# panelinde ELLE tanimlanir: https://schaferkibris.com/paytr/callback
# TEST_MODE=1 iken gercek para cekilmez. Canliya gecerken 0 yapin.
# ---------------------------------------------------------------------------
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
PAYTR_VERIFY_TLS=true
