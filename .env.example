APP_NAME="Schafer Kıbrıs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8190
APP_TIMEZONE=Asia/Famagusta

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@schaferkibris.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Magaza ---
SHOP_AD="Schafer Kıbrıs"
SHOP_ALAN_ADI=schaferkibris.com
SHOP_INSTAGRAM=
SHOP_KARGO_UCRET=150.00
SHOP_KARGO_UCRETSIZ_ESIGI=2500.00
SHOP_KARGO_FIRMA=
SHOP_SIPARIS_BILDIRIM=
SHOP_DUSUK_STOK_ESIGI=3
SHOP_BAKIM_MODU=false

SHOP_WHATSAPP=+905488477000

# Odeme yontemleri (panelde Site Ayarlari'ndan da degisir)
SHOP_ODEME_KART=true
SHOP_ODEME_HAVALE=true
SHOP_ODEME_KAPIDA=true
# Her satir: Banka | Hesap sahibi | IBAN  (bos ise havale kasada gorunmez)
SHOP_HAVALE_HESAPLARI=
SHOP_HAVALE_SURE_GUN=3
SHOP_KAPIDA_EK_UCRET=0

# Satici bilgileri (yasal metinler + fatura)
SHOP_SATICI_UNVAN=
SHOP_SATICI_ADRES="Düzyol Sokak No:10/B Gönyeli, Lefkoşa — KKTC (Garanti Bankası yanı)"
SHOP_SATICI_TELEFON="+90 392 223 55 56"
SHOP_SATICI_TELEFON2="+90 548 847 70 00"
SHOP_SATICI_EPOSTA=info@schaferkibris.com
SHOP_SATICI_MERSIS=
SHOP_SATICI_VERGI_DAIRESI=
SHOP_SATICI_VERGI_NO=

# --- PayTR --- (gercek degerler SADECE .env'de, depoya asla girmez)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
